<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>氪金之王</string>
	<key>CFBundleName</key>
	<string>KejinZhiWang</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- 真正的 LaunchScreen.storyboard。
	     只有 Info.plist 里的 UILaunchScreen 时，部分设备/部分重签名工具下
	     系统判定 App 没有为这块屏幕提供启动图，于是以「兼容模式」渲染：
	     画面被框在 4.7 寸的画布里再整体缩放居中，表现就是上下两条黑边。
	     提供标准的 launch storyboard 后系统才会按设备的真实分辨率渲染。 -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>游戏内的图片需要保存到相册</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- 本地 HTTP 服务走明文回环；WebView 内的混合内容同样放行 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- 开启 iTunes/Files 文件共享：让用户在「文件 App → 我的 iPhone」看到这个 App 目录
	     可以手动把 bin 拷进去。然后用 App 内的「浏览 App 目录」按钮读取，
     彻底避开 SwiftUI fileImporter 在 sideloaded App 上回调丢失的已知 bug -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
